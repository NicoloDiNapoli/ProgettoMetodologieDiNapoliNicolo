<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="30.0" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg125668.gui.controller.SetupController">

    <Label text="HerosOfUniversity" textFill="WHITE">
        <font>
            <Font name="System Bold" size="48.0" />
        </font>
    </Label>

    <VBox alignment="CENTER" spacing="15.0">
        <Button fx:id="newGameBtn" prefHeight="50.0" prefWidth="250.0" style="-fx-font-size: 18px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="NUOVA PARTITA" />

        <Button fx:id="loadGameBtn" prefHeight="50.0" prefWidth="250.0" style="-fx-font-size: 18px; -fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;" text="CARICA PARTITA" />

        <Button fx:id="exitBtn" prefHeight="50.0" prefWidth="250.0" style="-fx-font-size: 18px; -fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand;" text="ESCI" />
    </VBox>
</VBox>
